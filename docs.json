{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#8A2B2B",
    "light": "#D93663",
    "dark": "#621F1F"
  },
  "favicon": {
    "light": "/images/firstybot.png",
    "dark": "/images/firstybot.png"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Legal",
            "pages": [
              "terms",
              "privacy"
            ]
          }
        ]
      },
      {
        "language": "ro",
        "groups": [
          {
            "group": "Legal",
            "pages": [
              "ro/terms",
              "ro/privacy"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/firstybot.png",
    "dark": "/images/firstybot.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:padrewin@colddev.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://firsty.colddev.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/padrewin"
    },
    "links": [
      {
        "header": "Legal",
        "items": [
          {
            "label": "Terms of Service",
            "href": "/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "/privacy"
          }
        ]
      }
    ]
  },
  "icons": {
    "library": "fontawesome"
  },
  "thumbnails": {
    "background": "/images/firstybot.png"
  }
}
